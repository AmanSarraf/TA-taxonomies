# Copy to .env and fill in your own values. NEVER commit .env.

# --- Graph store (Neo4j, per ADR-0005) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Vector index (provisional: pgvector — see ADR-0005) ---
# PGVECTOR_URL=

# --- Taxonomy data sources (keys/paths per suite, as needed) ---
# ESCO_API_BASE=
# ONET_API_KEY=
# SFIA_DATA_PATH=
# BLS_DATA_PATH=
